{
  "name": "api_vid",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "start:miruro": "python src/providers/miruro/server.py",
    "dev": "node --env-file=.env --watch src/index.js",
    "check": "node --check src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "r2:test": "node --env-file=.env scripts/r2-test.js",
    "r2:select": "node --env-file=.env scripts/r2-select.js",
    "r2:fix": "node --env-file=.env scripts/r2-fix-playlist.js",
    "r2:fix-fmp4": "node --env-file=.env scripts/r2-fix-fmp4-naming.js",
    "r2:export": "node --env-file=.env scripts/r2-export.js",
    "r2:import": "node --env-file=.env scripts/r2-import.js",
    "r2:cleanup-multi-dubs": "node --env-file=.env scripts/r2-cleanup-multi-dubs.mjs",
    "r2:migrate-cr-subs": "node --env-file=.env scripts/r2-migrate-cr-subs.js",
    "r2:fix-cr-index-flags": "node --env-file=.env scripts/r2-fix-cr-index-flags.js"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "express": "^4.19.2",
    "https-proxy-agent": "^9.0.0",
    "puppeteer-extra": "^3.3.6",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.882.0",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.3",
    "puppeteer": "^24.43.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "engines": { "node": ">=22.0.0" }
}
