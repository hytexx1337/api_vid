.circularProgress_progress___85yx{width:70px;height:70px;transform-origin:center;animation:circularProgress_vidy-rotate__caHpn 2s linear infinite}.circularProgress_progress___85yx circle{fill:none;stroke:#fff;stroke-width:4;stroke-dasharray:1,200;stroke-dashoffset:0;stroke-linecap:round;animation:circularProgress_vidy-dash__BZfeW 1.5s ease-in-out infinite}@keyframes circularProgress_vidy-rotate__caHpn{to{transform:rotate(1turn)}}@keyframes circularProgress_vidy-dash__BZfeW{0%{stroke-dasharray:1,200;stroke-dashoffset:0}50%{stroke-dasharray:90,200;stroke-dashoffset:-35px}to{stroke-dashoffset:-125px}}