# Copiá este archivo a .env y completá los valores reales.
# node --env-file=.env src/index.js lee este archivo directamente.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
API_KEY=

# ── Proxies / Workers ─────────────────────────────────────────────────────────
EDGE_PROXY_BASE=
PROXY_CDN_BASE=
KAI_HTTP_PROXY=
KAI_CF_WORKER=
MIRURO_CF_WORKER=
MIRURO_API_URL=http://localhost:8001
MEGAVID_WORKER=
VIDUP_CF_WORKER=

# ── Provider toggles ──────────────────────────────────────────────────────────
# DISABLED_PROVIDERS=nombre1,nombre2
# ENABLE_<PROVIDER>=false

# ── Crunchyroll (completar corriendo: node src/providers/cr-login.mjs) ────────
CR_EMAIL=
CR_PASSWORD=
CR_REFRESH_TOKEN=
CR_DEVICE_ID=
CR_BASIC_AUTH=

# ── Cloudflare R2 (archivado de HLS) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SEAL_SECRET=
R2_WORKER_BASE=
R2_ARCHIVE_CONCURRENCY=4

# ── Proxy seal (firma de URLs internas de proxy) ───────────────────────────────
PROXY_SEAL_SECRET=

# ── Cinejoy ────────────────────────────────────────────────────────────────────
CINEJOY_PRIORITY_SERVERS=Lisbon,Solara,Nebula,Athens

# ── CineParaTodos API (lookup de títulos de episodios para Crunchyroll) ───────
CINE_API=https://api.cineparatodos.lat
